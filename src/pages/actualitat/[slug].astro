---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icona from '../../components/Icona.astro';
import TargetaEntrada from '../../components/TargetaEntrada.astro';
import { entradesPublicades, relacionades } from '../../lib/contingut';
import { categories, formataData, dataISO, web, urlCanonica, IMATGE_PER_DEFECTE } from '../../lib/web';

export const getStaticPaths = (async () => {
  const entrades = await entradesPublicades();
  return entrades.map((entrada) => ({ params: { slug: entrada.id }, props: { entrada } }));
}) satisfies GetStaticPaths;

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const cat = categories[entrada.data.categoria];
const esAlerta = entrada.data.categoria === 'alertes';
const altres = await relacionades(entrada);

const url = urlCanonica(`/actualitat/${entrada.id}`, Astro.site).toString();
const lloc = new URL('/', Astro.site).toString();
const absoluta = (ruta: string) => urlCanonica(ruta, Astro.site).toString();

// Dades estructurades: l'article i la ruta de navegació (molla de pa).
const esquema = [
  {
    '@type': entrada.data.categoria === 'blog' ? 'BlogPosting' : 'NewsArticle',
    '@id': `${url}#article`,
    headline: entrada.data.titol,
    description: entrada.data.resum,
    datePublished: entrada.data.data.toISOString(),
    dateModified: entrada.data.data.toISOString(),
    inLanguage: 'ca',
    articleSection: cat.plural,
    image: new URL(entrada.data.imatge ?? IMATGE_PER_DEFECTE, Astro.site).toString(),
    author: { '@id': `${lloc}#entitat` },
    publisher: { '@id': `${lloc}#entitat` },
    mainEntityOfPage: { '@id': `${url}#pagina` },
    isPartOf: { '@id': `${lloc}#web` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#molla`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inici', item: lloc },
      { '@type': 'ListItem', position: 2, name: 'Actualitat', item: absoluta('/actualitat') },
      { '@type': 'ListItem', position: 3, name: cat.plural, item: absoluta(cat.url) },
      { '@type': 'ListItem', position: 4, name: entrada.data.titol, item: url },
    ],
  },
];
const text = `${entrada.data.titol} — ${web.nom}`;
const compartir = [
  { nom: 'WhatsApp', url: `https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}` },
  { nom: 'Telegram', url: `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}` },
  { nom: 'Correu', url: `mailto:?subject=${encodeURIComponent(text)}&body=${encodeURIComponent(url)}` },
];
---
<Base
  titol={entrada.data.titol}
  descripcio={entrada.data.resum}
  tipus="article"
  dataPublicacio={entrada.data.data}
  imatge={entrada.data.imatge}
  imatgeAlt={entrada.data.imatge_alt}
  esquema={esquema}
>
  <article class="seccio seccio--compacta">
    <div class="contenidor contenidor--estret">
      <nav class="molla" aria-label="Ets aquí">
        <a href="/actualitat">Actualitat</a>
        <span aria-hidden="true">›</span>
        <a href={cat.url}>{cat.plural}</a>
      </nav>

      <header class:list={['entrada__capcalera', { 'entrada__capcalera--alerta': esAlerta }]}>
        <p class="meta">
          <span class={`etiqueta etiqueta--${entrada.data.categoria}`}>
            {esAlerta && <Icona nom="alerta" mida={16} />}
            {cat.nom}
          </span>
          <time datetime={dataISO(entrada.data.data)}>{formataData(entrada.data.data)}</time>
        </p>
        <h1>{entrada.data.titol}</h1>
        <p class="entrada__resum">{entrada.data.resum}</p>
      </header>

      {entrada.data.imatge && (
        <img
          class="entrada__imatge"
          src={entrada.data.imatge}
          alt={entrada.data.imatge_alt ?? ''}
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
      )}

      <div class="prosa entrada__cos">
        <Content />
      </div>

      <footer class="entrada__peu">
        <h2 class="entrada__peu-titol">Comparteix-ho</h2>
        <p class="entrada__compartir">
          <Icona nom="compartir" mida={20} />
          {compartir.map((c) => (
            <a class="boto boto--secundari" href={c.url} rel="noopener noreferrer nofollow" target="_blank">
              {c.nom} <span class="nomes-lector">(s'obre en una finestra nova)</span>
            </a>
          ))}
        </p>
        {esAlerta && (
          <p class="nota nota--avis">
            Has rebut un missatge com aquest i no saps què fer?
            Consulta <a href="/he-patit-una-estafa">He patit una estafa</a>.
          </p>
        )}
      </footer>
    </div>
  </article>

  {altres.length > 0 && (
    <section class="seccio seccio--suau" aria-labelledby="relacionades">
      <div class="contenidor">
        <h2 id="relacionades" class="titol-seccio">Més {cat.plural.toLowerCase()}</h2>
        <ul class="graella graella--3 sense-llista">
          {altres.map((e) => (<li><TargetaEntrada entrada={e} /></li>))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .molla {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--t-petit);
    color: var(--text-suau);
    margin-bottom: 1.25rem;
  }
  .molla a { color: var(--text-suau); }

  .entrada__capcalera { margin-bottom: 1.75rem; }
  .entrada__capcalera--alerta {
    border-left: 8px solid var(--avis);
    background: var(--avis-suau);
    border-radius: var(--radi-m);
    padding: 1.25rem 1.5rem;
  }
  .entrada__capcalera h1 { margin-top: 0.7rem; }
  .entrada__resum {
    font-size: var(--t-gran);
    color: var(--text-suau);
    margin-bottom: 0;
  }
  .entrada__capcalera--alerta .entrada__resum { color: var(--text); }

  .entrada__imatge {
    width: 100%;
    border-radius: var(--radi-l);
    margin-bottom: 2rem;
    background: var(--fons-suau);
  }

  .entrada__cos :global(h2) { font-size: var(--t-h3); }
  .entrada__cos :global(h3) { font-size: var(--t-h4); }
  .entrada__cos :global(blockquote) {
    background: var(--principal-suau);
    border-left-color: var(--principal);
    border-radius: 0 var(--radi-s) var(--radi-s) 0;
    padding: 1rem 1.25rem;
    font-style: normal;
    color: var(--text);
  }
  .entrada__cos :global(ol) { padding-left: 1.4em; }

  .entrada__peu {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--vora);
  }
  .entrada__peu-titol { font-size: var(--t-petit); text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-suau); }
  .entrada__compartir {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .entrada__compartir .boto { min-height: 44px; padding: 0.45rem 1.1rem; font-size: var(--t-petit); }
</style>
