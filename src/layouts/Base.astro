---
import '../styles/global.css';
import Capcalera from '../components/Capcalera.astro';
import Peu from '../components/Peu.astro';
import { web, urlCanonica, IMATGE_PER_DEFECTE } from '../lib/web';

interface Props {
  titol: string;
  descripcio: string;
  imatge?: string;
  tipus?: 'website' | 'article';
  imatgeAlt?: string;
  dataPublicacio?: Date;
  senseIndexar?: boolean;
  /** Dades estructurades (schema.org) pròpies de la pàgina, que s'afegeixen al graf comú. */
  esquema?: Record<string, unknown>[];
}

const {
  titol,
  descripcio,
  imatge = IMATGE_PER_DEFECTE,
  imatgeAlt,
  tipus = 'website',
  dataPublicacio,
  senseIndexar = false,
  esquema = [],
} = Astro.props;

const titolComplet = titol === web.nom ? `${web.nom} — ${web.lema}` : `${titol} | ${web.nom}`;
const canonica = urlCanonica(Astro.url.pathname, Astro.site);
const imatgeAbs = new URL(imatge, Astro.site);
const esImatgePerDefecte = imatge === IMATGE_PER_DEFECTE;
const lloc = new URL('/', Astro.site).toString();

// Graf schema.org: entitat, lloc web i pàgina, més el que hi afegeixi cada pàgina.
const grafEsquema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NGO',
      '@id': `${lloc}#entitat`,
      name: web.nomLlarg,
      alternateName: web.nom,
      url: lloc,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/imatges/logo-connectats.jpg', Astro.site).toString(),
        width: 2191,
        height: 1043,
      },
      image: new URL(IMATGE_PER_DEFECTE, Astro.site).toString(),
      email: web.correu,
      description: web.descripcio,
      areaServed: { '@type': 'AdministrativeArea', name: 'Catalunya' },
      knowsLanguage: 'ca',
      sameAs: web.xarxes.map((x) => x.url),
    },
    {
      '@type': 'WebSite',
      '@id': `${lloc}#web`,
      url: lloc,
      name: web.nomLlarg,
      alternateName: web.nom,
      description: web.descripcio,
      inLanguage: 'ca',
      publisher: { '@id': `${lloc}#entitat` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonica}#pagina`,
      url: canonica.toString(),
      name: titolComplet,
      description: descripcio,
      inLanguage: 'ca',
      isPartOf: { '@id': `${lloc}#web` },
      about: { '@id': `${lloc}#entitat` },
      primaryImageOfPage: imatgeAbs.toString(),
      ...(dataPublicacio && { datePublished: dataPublicacio.toISOString() }),
    },
    ...esquema,
  ],
};
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolComplet}</title>
    <meta name="description" content={descripcio} />
    <link rel="canonical" href={canonica} />
    <meta
      name="robots"
      content={senseIndexar ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {!senseIndexar && <link rel="alternate" hreflang="ca" href={canonica} />}
    {!senseIndexar && <link rel="alternate" hreflang="x-default" href={canonica} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1A20" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title={`Actualitat de ${web.nom}`} href="/rss.xml" />

    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={tipus} />
    <meta property="og:site_name" content={web.nomLlarg} />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:title" content={titolComplet} />
    <meta property="og:description" content={descripcio} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imatgeAbs} />
    {esImatgePerDefecte && <meta property="og:image:width" content="1200" />}
    {esImatgePerDefecte && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={esImatgePerDefecte ? `Logotip de ${web.nomLlarg}` : (imatgeAlt || titol)} />
    {dataPublicacio && <meta property="article:published_time" content={dataPublicacio.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titolComplet} />
    <meta name="twitter:description" content={descripcio} />
    <meta name="twitter:image" content={imatgeAbs} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(grafEsquema)} />
  </head>

  <body>
    <a class="salta" href="#contingut">Salta al contingut</a>
    <Capcalera />
    <main id="contingut" tabindex="-1">
      <slot />
    </main>
    <Peu />
  </body>
</html>
