---
import { menu, menuLegal, web } from '../lib/web';
import Icona from './Icona.astro';
const any = new Date().getFullYear();
---
<footer class="peu">
  <div class="contenidor peu__interior">
    <div class="peu__bloc peu__bloc--marca">
      <a class="peu__marca" href="/">
        <img src="/imatges/logo-connectats.svg" alt={`${web.nom} — ${web.lema}`} width="528" height="237" />
      </a>
      <p class="peu__descripcio">{web.descripcio}</p>
      <p class="peu__registre">Entitat sense ànim de lucre. {web.registre} <span class="pendent">[PENDENT]</span></p>
    </div>

    <nav class="peu__bloc" aria-label="Seccions">
      <h2>Seccions</h2>
      <ul class="sense-llista">
        {menu.map((i) => (<li><a href={i.url}>{i.text}</a></li>))}
        <li><a href="/he-patit-una-estafa">He patit una estafa</a></li>
      </ul>
    </nav>

    <nav class="peu__bloc" aria-label="Informació legal">
      <h2>Informació legal</h2>
      <ul class="sense-llista">
        {menuLegal.map((i) => (<li><a href={i.url}>{i.text}</a></li>))}
      </ul>
    </nav>

    <div class="peu__bloc">
      <h2>Contacte</h2>
      <ul class="sense-llista">
        <li>
          <a href={`mailto:${web.correu}`} class="peu__enllac-icona">
            <Icona nom="correu" mida={20} /> {web.correu}
          </a>
        </li>
        {web.xarxes.map((x) => (
          <li>
            <a href={x.url} rel="me noopener noreferrer" target="_blank" class="peu__enllac-icona">
              <Icona nom="extern" mida={20} /> {x.nom}
            </a>
          </li>
        ))}
        <li>
          <a href="/rss.xml" class="peu__enllac-icona">
            <Icona nom="rss" mida={20} /> Fil RSS d'Actualitat
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="contenidor peu__base">
    <p>© {any} {web.nomLlarg}. Contingut sota llicència <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.ca" rel="license noopener noreferrer" target="_blank">CC BY-SA 4.0</a> <span class="pendent">[PENDENT DE CONFIRMAR]</span></p>
    <p class="peu__privadesa">Aquesta web no utilitza galetes de seguiment ni recull dades de navegació.</p>
  </div>
</footer>

<style>
  .peu {
    margin-top: clamp(3rem, 8vw, 6rem);
    background: var(--fons-suau);
    border-top: 1px solid var(--vora);
    position: relative;
  }
  .peu__interior {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 2rem;
  }
  .peu__bloc--marca { grid-column: span 1; }
  @media (min-width: 60rem) {
    .peu__interior { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; }
  }
  .peu h2 {
    font-size: var(--t-petit);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-suau);
    margin-bottom: 0.8rem;
  }
  .peu ul li { margin-bottom: 0.15rem; }
  .peu a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
    padding: 0.2rem 0;
  }
  .peu a:hover { color: var(--principal); text-decoration: underline; }
  .peu__marca { gap: 0.65rem; }
  .peu__marca img { width: 180px; height: auto; }
  .peu__descripcio { color: var(--text-suau); font-size: var(--t-petit); margin-top: 0.8rem; }
  .peu__registre { color: var(--text-suau); font-size: var(--t-mini); }
  .peu__base {
    border-top: 1px solid var(--vora);
    padding-block: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    justify-content: space-between;
    font-size: var(--t-mini);
    color: var(--text-suau);
  }
  .peu__base p { margin: 0; }
  .peu__base a { display: inline; min-height: 0; color: var(--principal); text-decoration: underline; }
  .pendent {
    font-size: 0.8em;
    color: var(--avis);
    font-weight: 700;
    white-space: nowrap;
  }
</style>
