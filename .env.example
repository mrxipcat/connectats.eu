# Copieu aquest fitxer a «.env» i ompliu-ne els valors.
# El fitxer «.env» NO s'ha de pujar mai al repositori.

# Adreça del servei que rep el formulari de contacte.
# Mentre estigui buida, el formulari surt desactivat amb un avís i l'adreça de correu.
# Cal escollir un servei europeu i respectuós amb la privadesa (vegeu el README).
PUBLIC_FORM_ENDPOINT=

# Domini definitiu del lloc (sense barra final). Per defecte: https://connectats.eu
SITE_URL=https://connectats.eu
